// ---------------------------------------------------------------------------
// Sales Book SaaS — Prisma schema
//
// PostgreSQL schema for the whole platform. Every tenant-owned model carries a
// `businessId` so data can never leak between businesses (multi-tenancy is
// enforced in the backend services using this column).
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  BUSINESS_OWNER
  MANAGER
  STAFF
}

enum BusinessStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  SUSPENDED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SalePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum SalePaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum FeatureKind {
  // A numeric limit that is compared against recorded usage (e.g. MAX_PRODUCTS)
  LIMIT
  // A simple on/off capability (e.g. EXPORT_DATA)
  BOOLEAN
}

// ---------------------------------------------------------------------------
// Users & authentication
// ---------------------------------------------------------------------------

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  role             Role     @default(STAFF)
  isActive         Boolean  @default(true)
  businessId       String?
  business         Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Only the latest refresh token hash is kept; it is rotated on every refresh.
  refreshTokenHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales          Sale[] @relation("SoldBy")
  auditLogs      AuditLog[]
  passwordResets PasswordReset[]

  @@index([businessId])
  @@index([email])
}

// One-time password reset tokens (hashed, never stored in plain text)
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Tenant (business) & its people
// ---------------------------------------------------------------------------

model Business {
  id      String         @id @default(cuid())
  name    String
  slug    String         @unique
  email   String?
  phone   String?
  address String?
  status  BusinessStatus @default(ACTIVE)
  // When set, the business was archived by a Super Admin
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  customers     Customer[]
  products      Product[]
  sales         Sale[]
  subscriptions Subscription[]
  usage         Usage[]
  payments      PaymentTransaction[]
  auditLogs     AuditLog[]
}

// ---------------------------------------------------------------------------
// Core SME domain
// ---------------------------------------------------------------------------

model Customer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  phone      String?
  address    String?
  notes      String?
  isArchived Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales Sale[]

  @@unique([businessId, email])
  @@index([businessId])
  @@index([businessId, name])
}

model Product {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  sku           String?
  category      String?
  price         Decimal  @db.Decimal(12, 2)
  costPrice     Decimal? @db.Decimal(12, 2)
  // null = stock is not tracked; a number = stock is enforced on sales
  stockQuantity Int?
  isArchived    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleItems SaleItem[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([businessId, name])
}

model Sale {
  id            String            @id @default(cuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleNumber    String            // human friendly number, unique per business
  status        SaleStatus        @default(COMPLETED)
  customerId    String?
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subtotal      Decimal           @db.Decimal(12, 2)
  discount      Decimal           @default(0) @db.Decimal(12, 2)
  tax           Decimal           @default(0) @db.Decimal(12, 2)
  total         Decimal           @db.Decimal(12, 2)
  paymentStatus SalePaymentStatus @default(UNPAID)
  paymentMethod SalePaymentMethod?
  soldById      String
  soldBy        User              @relation("SoldBy", fields: [soldById], references: [id])
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SaleItem[]

  @@unique([businessId, saleNumber])
  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([customerId])
}

// Line items snapshot the product name/price so historical sales stay intact
// even if a product is later renamed or deleted.
model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  unitPrice   Decimal  @db.Decimal(12, 2)
  quantity    Int
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)

  @@index([saleId])
}

// ---------------------------------------------------------------------------
// Subscriptions, features & usage
// ---------------------------------------------------------------------------

// A plan is fully configurable by the Super Admin — no plan logic is hard-coded.
model SubscriptionPlan {
  id              String          @id @default(cuid())
  code            String          @unique // e.g. FREE, STARTER, BUSINESS, PRO
  name            String
  description     String?
  price           Decimal         @db.Decimal(12, 2)
  currency        String          @default("NGN")
  billingInterval BillingInterval @default(MONTHLY)
  isActive        Boolean         @default(true)
  isDefault       Boolean         @default(false)
  sortOrder       Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  features      PlanFeature[]
  subscriptions Subscription[]
  payments      PaymentTransaction[]
}

// Canonical list of every feature the platform knows about.
model Feature {
  id          String      @id @default(cuid())
  key         String      @unique // e.g. MAX_PRODUCTS, EXPORT_DATA
  name        String
  description String?
  kind        FeatureKind

  createdAt DateTime @default(now())

  planFeatures PlanFeature[]
}

// Links a plan to a feature with its configured value (a limit or a boolean).
model PlanFeature {
  id         String           @id @default(cuid())
  planId     String
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId  String
  feature    Feature          @relation(fields: [featureId], references: [id], onDelete: Cascade)
  limitValue Int?             // used when the feature kind is LIMIT
  boolValue  Boolean?         // used when the feature kind is BOOLEAN

  createdAt DateTime @default(now())

  @@unique([planId, featureId])
}

// A business has exactly one subscription at a time.
model Subscription {
  id                 String             @id @default(cuid())
  businessId         String
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId             String
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments PaymentTransaction[]
  history  SubscriptionHistory[]

  @@unique([businessId])
  @@index([planId])
}

// Audit trail of everything that happens to a subscription (created, upgraded…).
model SubscriptionHistory {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  action         String
  fromPlanId     String?
  toPlanId       String?
  notes          String?

  createdAt DateTime @default(now())

  @@index([subscriptionId])
}

// Recorded usage per business, per feature, per period.
// period is "YYYY-MM" for monthly counters (MAX_MONTHLY_SALES) or "ALL" for
// lifetime counters (MAX_USERS, MAX_PRODUCTS, MAX_CUSTOMERS).
model Usage {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  featureKey String
  period     String
  count      Int      @default(0)

  updatedAt DateTime @updatedAt

  @@unique([businessId, featureKey, period])
  @@index([businessId])
}

// ---------------------------------------------------------------------------
// Payments & billing
// ---------------------------------------------------------------------------

model PaymentProvider {
  code      String   @id // e.g. "paystack" | "flutterwave"
  name      String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentTransaction {
  id             String             @id @default(cuid())
  businessId     String
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  planId         String?
  plan           SubscriptionPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  amount         Decimal            @db.Decimal(12, 2)
  currency       String             @default("NGN")
  provider       String             // provider code, e.g. "paystack"
  reference      String             @unique
  status         TransactionStatus  @default(PENDING)
  metadata       Json?              // authorization URL, raw provider response…

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessId])
  @@index([status])
  @@index([provider])
}

// ---------------------------------------------------------------------------
// Platform-wide concerns
// ---------------------------------------------------------------------------

// Sensitive administrative actions (Super Admin changes, subscription changes…)
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([userId])
  @@index([action])
}

// Centralised key/value store for Super Admin platform settings.
model PlatformSetting {
  key       String   @id
  value     Json?
  updatedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
