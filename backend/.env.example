# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
PORT=3002
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Base URL of the frontend (used to build links sent in emails)
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_book?schema=public

# ------------------------------------------------------------------
# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------------
# Payments — Paystack (https://paystack.com)
# ------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3000/billing/verify

# ------------------------------------------------------------------
# Payments — Flutterwave (https://flutterwave.com)
# ------------------------------------------------------------------
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_CALLBACK_URL=http://localhost:3000/billing/verify
# Optional: if you set a custom hash on the Flutterwave dashboard, mirror it here
FLUTTERWAVE_WEBHOOK_HASH=

# ------------------------------------------------------------------
# Seed admin account (created by `npm run db:seed`)
# ------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
